---
import { stoConsortiums } from '../../utils/ceo';
import { brokers } from '../../utils/brokers';
import { sitePath } from '../../utils/paths';
const brokerNames = new Map(brokers.map(({ id, name }) => [id, name]));
const { asOf, note, rows } = stoConsortiums;
const pending = rows.filter(({ status }) => status.startsWith('자료 확인 중')).length;
---
<section class="lab-block" id="sto-consortiums">
  <h2>토큰증권 컨소시엄별 발표 사실과 확인된 현황</h2>
  <p>{note} 기준일 <time datetime={asOf}>{asOf}</time>. 수록 {rows.length}건{pending > 0 && `, 이 중 ${pending}건은 후속 자료 확인 중`}.</p>
  <div class="lab-table-wrap" role="region" tabindex="0" aria-label="토큰증권 컨소시엄 표, 옆으로 밀어 볼 수 있음">
    <table class="lab-table">
      <caption>컨소시엄 결성 발표와 공개 자료로 확인한 현황. 준비 수준의 우열은 비교하지 않습니다.</caption>
      <thead>
        <tr><th scope="col">컨소시엄</th><th scope="col">주도</th><th scope="col">참여</th><th scope="col">결성 발표</th><th scope="col">대상·초점</th><th scope="col">확인된 현황 (기준일)</th><th scope="col">출처</th></tr>
      </thead>
      <tbody>
        {rows.map(({ consortium, leadBroker, brokerId, brokerIds, members, announced, focus, status, statusAsOf, statusSources, sourceUrl, sourceName }) => <tr>
          <th scope="row">{consortium}</th>
          <td>{brokerId ? <a href={sitePath('broker-atlas/brokers/' + brokerId)}>{leadBroker}</a> : leadBroker}</td>
          <td>{members}{brokerIds.length > 0 && <small> · Broker Atlas: {brokerIds.map((id, index) => <>{index > 0 && ', '}<a href={sitePath('broker-atlas/brokers/' + id)}>{brokerNames.get(id) ?? id}</a></>)}</small>}</td>
          <td><time datetime={announced}>{announced}</time></td>
          <td>{focus}</td>
          <td>{status} <small>(<time datetime={statusAsOf}>{statusAsOf}</time> 기준)</small></td>
          <td>
            <a href={sourceUrl}>{sourceName}</a>
            {statusSources.map(({ name, url }) => <> · <a href={url}>{name}</a></>)}
          </td>
        </tr>)}
      </tbody>
    </table>
  </div>
</section>
