---
import { ceoSections, type signals } from '../../utils/ceo';
import { sitePath } from '../../utils/paths';
import GlobalCaseCard from './GlobalCaseCard.astro';
import SignalDetails from './SignalDetails.astro';
import HashReveal from '../common/HashReveal.astro';
// variant="card" (default): the card shows the date, title, confirmed fact, question and source; the context lines
// fold into <details> so a list of signals reads as a report rather than a wall of equal-weight cards.
// variant="fold": one details.lab-fold per signal. The summary is the compact row (date · topic chip · title); the body
// holds the fact, question, source, case body and context lines. Links into a row open it (HashReveal).
// variant="index": one compact row per signal (date · topic · title → full card · source) for the archive.
// With `cases`, signals that carry a sourced case study show the institution instead of the region, and the §10.12
// case body (problem, what was introduced, what changed) sits with the question and source.
interface Props { items: typeof signals; cases?: boolean; variant?: 'card' | 'index' | 'fold'; heading?: 'h2' | 'h3' | 'h4'; }
const { items, cases = false, variant = 'card', heading = variant === 'fold' ? 'h3' : 'h2' } = Astro.props;
const Heading = heading;
const topicSlugs = ceoSections.map(([, slug]) => slug as string).filter((slug) => !['signals', 'archive', 'methodology'].includes(slug));
// The row title points at the full card on the first topic page that lists the signal, or the all-signals page.
const cardPage = (areas: string[], id: string) => sitePath('ceo-lens/' + (areas.find((area) => topicSlugs.includes(area)) ?? 'signals')) + '#' + id;
const regionLabel = (region: string) => region === 'KR' ? '국내' : '해외';
---
{variant === 'index' ? <ul class="lab-list lab-list--rows signal-list">
  {items.map(({ id, date, category, title, region, businessAreas, applications, areas, sourceName, sourceUrl }) => (
    <li data-year={date.slice(0, 4)} data-topic={category} data-region={region} data-area={businessAreas.join('|')} data-application={applications?.join('|')}>
      <time datetime={date}>{date}</time>
      <span class="lab-chip">{category} · {regionLabel(region)}</span>
      <a class="row-title" href={cardPage(areas, id)}>{title}</a>
      <a class="row-source" href={sourceUrl}>{sourceName}</a>
    </li>
  ))}
</ul> : variant === 'fold' ? <>
  <ul class="lab-list signal-list signal-folds">
    {items.map((signal) => {
      const { id, date, category, title, summary, question, region, businessAreas, sourceName, sourceUrl, stage, applications, regulator, case: caseStudy } = signal;
      const isCase = cases && Boolean(caseStudy);
      return <li id={id} data-year={date.slice(0, 4)} data-topic={category} data-region={region} data-area={businessAreas.join('|')} data-application={applications?.join('|')} data-case={isCase ? '' : undefined}>
        <details class="lab-fold signal-fold">
          <summary>
            <time datetime={date}>{date}</time>
            <span class="lab-chip">{category} · {isCase ? regulator : regionLabel(region)}{stage && ' · ' + stage}</span>
            <Heading class="signal-fold__title">{title}</Heading>
          </summary>
          <dl>
            {isCase ? <><dt>한국 증권업에 던지는 질문</dt><dd>{question}</dd></> : <>
              <dt>확인한 사실</dt><dd>{summary}</dd>
              <dt>생각해 볼 질문</dt><dd>{question}</dd>
            </>}
          </dl>
          <p><a href={sourceUrl}>{sourceName}</a></p>
          {isCase && caseStudy && <GlobalCaseCard {caseStudy} />}
          <SignalDetails {signal} {isCase} />
        </details>
      </li>;
    })}
  </ul>
  <HashReveal />
</> : <ul class="lab-list signal-list">
  {items.map((signal) => {
    const { id, date, category, title, summary, question, region, businessAreas, sourceName, sourceUrl, stage, applications, regulator, case: caseStudy } = signal;
    const isCase = cases && Boolean(caseStudy);
    return <li class="lab-card signal-card" id={id} data-year={date.slice(0, 4)} data-topic={category} data-region={region} data-area={businessAreas.join("|")} data-application={applications?.join('|')} data-case={isCase ? '' : undefined}>
      <div class="signal-meta"><time datetime={date}>{date}</time><span>{category}{isCase ? ' · ' + regulator : ' · ' + regionLabel(region)}{stage && ' · ' + stage}</span></div>
      <Heading>{title}</Heading>
      <dl>
        {isCase ? <><dt>한국 증권업에 던지는 질문</dt><dd>{question}</dd></> : <>
          <dt>확인한 사실</dt><dd>{summary}</dd>
          <dt>생각해 볼 질문</dt><dd>{question}</dd>
        </>}
      </dl>
      <a href={sourceUrl}>{sourceName}</a>
      <details class="signal-more lab-fold">
        <summary>{isCase ? '사례 내용 · ' : ''}살펴볼 이유와 관련 기관</summary>
        {isCase && caseStudy && <GlobalCaseCard {caseStudy} />}
        <SignalDetails {signal} {isCase} />
      </details>
    </li>;
  })}
</ul>}
