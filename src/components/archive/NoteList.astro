---
import type { notes } from '../../utils/archive';
import { sitePath } from '../../utils/paths';

interface Props { items: typeof notes; }
const { items } = Astro.props;
---
<ul class="lab-list">
  {items.map(({ date, title, slug, tags, summary }) => (
    <li data-search={[date, title, summary, ...tags].join(" ").toLowerCase()}>
      <time datetime={date}>{date}</time>
      <a href={sitePath('normalman-archive/notes/' + encodeURIComponent(slug))}>{title}</a>
    </li>
  ))}
</ul>
