---
import LabLayout from '../common/LabLayout.astro';
interface Props { title: string; }
const { title } = Astro.props;
const links: Array<[string, string]> = [['Normalman Archive', ''], ['타임라인', 'timeline'], ['프로젝트', 'projects'], ['소개', 'about']];
---
<LabLayout slug="normalman-archive" title={title} accent="#d0c3b6" links={links}>
  <slot name="intro" slot="intro" />
  <slot />
</LabLayout>
