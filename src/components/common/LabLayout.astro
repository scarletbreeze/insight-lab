---
import ServiceMenu from './ServiceMenu.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { sitePath } from '../../utils/paths';
import '../../styles/labs.css';

interface Props {
  slug: string;
  title: string;
  heading?: string;
  section?: string;
  accent?: string;
  links: Array<[string, string]>;
}
const { slug, title, heading = title, accent, links, section } = Astro.props;
---
<BaseLayout title={title}>
  <div class="lab-page" data-service={slug} data-service-home={Astro.url.pathname === sitePath(slug) || undefined} style={accent ? `--lab-accent: ${accent}` : undefined}>
    <header class="lab-heading"><h1>{heading}</h1><slot name="intro" /></header>
    <ServiceMenu {slug} {links} {section} />
    <slot />
  </div>
</BaseLayout>
