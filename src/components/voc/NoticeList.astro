---
import { noticeWindowStatus, windowLabels, type vocNotices } from '../../utils/voc';
import { sitePath } from '../../utils/paths';
interface Props { items: typeof vocNotices; }
const { items } = Astro.props;
---
{items.length ? <ul class="lab-list">
  {items.map(({ id, date, dateType, title, category, summary, sourceUrl, topic, channel }) => {
    const status = noticeWindowStatus(id);
    return <li class="lab-card" id={id} data-notice-year={date.slice(0, 4)} data-notice-category={category} data-notice-topic={topic} data-notice-channel={channel} data-window-status={status}>
      <div><time datetime={date}>{date}</time><span>{dateType === "effective" ? "적용·안내 대상일" : "게시일"} · {category} · {channel}</span></div>
      <strong>{title}</strong>{summary && <p>{summary}</p>}<a href={sourceUrl}>키움증권 원문</a>
      <p>{status === 'observed' ? <a href={sitePath('voc-studio/year/' + date.slice(0, 4)) + '#notice-window-' + id}>게시 전후 14일 문의 비교</a> : '문의 비교 · ' + windowLabels[status]}</p>
    </li>;
  })}
</ul> : <p class="empty-state">공지 자료 확인 중</p>}
