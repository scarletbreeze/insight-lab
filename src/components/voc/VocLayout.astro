---
import LabLayout from '../common/LabLayout.astro';
interface Props { title: string; }
const { title } = Astro.props;
const links: Array<[string, string]> = [['VOC Studio', ''], ['주제', 'topics'], ['공지 타임라인', 'timeline'], ['연도 비교', 'compare'], ['방법론', 'methodology']];
---
<LabLayout slug="voc-studio" title={title} links={links} accent="#ff9eb8">
  <slot name="intro" slot="intro" />
  <slot />
</LabLayout>
