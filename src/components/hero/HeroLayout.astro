---
import ServiceMenu from '../common/ServiceMenu.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { sitePath } from '../../utils/paths';
import '../../styles/hero.css';

interface Props { title: string; heading?: string; }
const { title, heading = title } = Astro.props;
const slug = 'hero-lab';
const links: Array<[string, string]> = [
  ['Hero Lab', ''], ['화면 탐색', 'discover'], ['추천 조합', 'recipes'], ['화면 지도', 'map'],
  ['모니터 배치', 'layouts'], ['Hall of Fame', 'hall-of-fame'], ['화면 인사이트', 'insights'], ['공식 화면 색인', 'directory'],
];
const section = Astro.url.pathname.startsWith(sitePath('hero-lab/screens')) ? 'discover' : undefined;
---
<BaseLayout title={title}>
  <div class="hero-lab" data-service={slug} data-service-home={Astro.url.pathname === sitePath(slug) || undefined}>
    <header class="hero-heading"><h1>{heading}</h1><slot name="intro" /></header>
    <ServiceMenu {slug} {links} {section} />
    <slot />
  </div>
</BaseLayout>
