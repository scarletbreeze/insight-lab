---
import type { brokers } from '../../utils/brokers';
interface Props { broker: (typeof brokers)[number]; }
const { broker } = Astro.props;
---
{broker.map.length ? <ol class="money-flows" aria-label={broker.name + ' 수익구조'}>
  {broker.map.map(({ customer, business, revenue }) => (
    <li class="money-flow">
      <div><span>고객</span><strong>{customer}</strong></div>
      <span class="money-arrow" aria-hidden="true">→</span>
      <div><span>사업</span><strong>{business}</strong></div>
      <span class="money-arrow" aria-hidden="true">→</span>
      <div><span>수익원</span><strong>{revenue}</strong></div>
    </li>
  ))}
</ol> : <p class="empty-state">사업 구조 자료 확인 중</p>}
