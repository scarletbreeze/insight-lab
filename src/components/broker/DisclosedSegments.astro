---
import { formatSegmentAmount, segmentFilings, segmentTag } from '../../utils/broker-segments';
import { brokers } from '../../utils/brokers';
interface Props { brokerId: string; }
const { brokerId } = Astro.props;
const filing = segmentFilings[brokerId];
const brokerName = brokers.find(({ id }) => id === brokerId)?.name ?? brokerId;
const latestIndex = filing ? filing.years.length - 1 : 0;
const segments = [...(filing?.segments ?? [])].sort((a, b) => b.amounts[latestIndex] - a.amounts[latestIndex]);
const scale = Math.max(1, ...segments.map(({ amounts }) => Math.abs(amounts[latestIndex])));
---
{filing && <section class="lab-block" id={'disclosed-segments-' + brokerId}>
  <h2>공시 부문별 {filing.metric}</h2>
  <p>{filing.basis} · {filing.period ?? '연간 결산'} · 단위 억 원. 부문명과 연결 조정 항목은 공시 표기를 따릅니다.</p>
  <figure>
    <figcaption>{filing.years[latestIndex]}년 {filing.period} 부문별 {filing.metric} · 억 원</figcaption>
    <ul class="segments">{segments.map(({ name, amounts }) => <li>
      <span>{name}</span>
      <span class="track" aria-hidden="true"><i class:list={[{ negative: amounts[latestIndex] < 0 }]} style={{ width: Math.abs(amounts[latestIndex]) / scale * 50 + '%' }}></i></span>
      <span class="amount">{formatSegmentAmount(amounts[latestIndex], filing.unit)}</span>
    </li>)}</ul>
  </figure>
  <div class="lab-table-wrap" role="region" aria-label={brokerName + ' ' + (filing.period ?? '연간 결산') + ' 부문별 ' + filing.metric + ' 공시 표'} tabindex="0">
    <table class="lab-table">
      <thead><tr><th scope="col">공시 부문</th><th scope="col">공통 업무 분류</th>{filing.years.map((year) => <th scope="col">{year}년 {filing.period}</th>)}</tr></thead>
      <tbody>{filing.segments.map(({ name, amounts }) => <tr>
        <th scope="row">{name}</th><td>{segmentTag(name)}</td>{amounts.map((value) => <td>{formatSegmentAmount(value, filing.unit)}</td>)}
      </tr>)}</tbody>
      <tfoot><tr><th scope="row" colspan="2">연결 합계</th>{filing.total.map((value) => <td>{formatSegmentAmount(value, filing.unit)}</td>)}</tr></tfoot>
    </table>
  </div>
  <p><a href={filing.sourceUrl}>{filing.sourceName}</a></p>
</section>}
<style>
  figure { margin: 1rem 0; }
  .segments { list-style: none; padding: 0; }
  .segments li { display: grid; grid-template-columns: minmax(5rem, 1fr) minmax(3rem, 2fr) auto; gap: .5rem; align-items: center; }
  .track { position: relative; height: 1.25rem; }
  .track::before { content: ''; position: absolute; left: 50%; height: 100%; border-left: 1px solid var(--color-muted); }
  .track i { position: absolute; top: 25%; height: 50%; left: 50%; background: var(--color-accent-blue); }
  .track i.negative { left: auto; right: 50%; background: var(--color-accent-red); }
  .amount { font-variant-numeric: tabular-nums; text-align: right; }
</style>
