---
import benchmarkData from '../../../data/market/us-annual-benchmarks.json';

interface Props { year: number }
const { year } = Astro.props;
const rows = Object.values(benchmarkData).flatMap(({ label, sourceName, sourceUrl, years }) => {
  const value = (years as Record<string, number | undefined>)[year];
  return value == null ? [] : [{ label, sourceName, sourceUrl, value }];
});
const percent = new Intl.NumberFormat('ko-KR', { style: 'percent', signDisplay: 'exceptZero', maximumFractionDigits: 2 });
---
{rows.length > 0 && <section class="lab-block" id="us-annual-index">
  <h2>미국 주요 지수 연간 등락률</h2>
  <p>지수 산출기관의 보고서에 수록된 전년 말 대비 해당 연말 가격 수익률입니다. 배당은 제외합니다.</p>
  <dl class="lab-grid">
    {rows.map(({ label, value, sourceName, sourceUrl }) => <div class="lab-card">
      <dt>{label}</dt>
      <dd><strong>{percent.format(value / 100)}</strong></dd>
      <dd><a href={sourceUrl}>{sourceName}</a></dd>
    </div>)}
  </dl>
</section>}
