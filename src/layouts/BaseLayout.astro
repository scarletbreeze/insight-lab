---
import '../styles/global.css';
import { sitePath } from '../utils/paths';
import { services } from '../utils/services';

const { title } = Astro.props;
const github = 'https://github.com/scarletbreeze/insight_lab';
const nav = [
  ...services.map(({ title, slug }) => ({ title, href: sitePath(slug) })),
  { title: '검색', href: sitePath('search') },
  { title: '소개', href: sitePath('about') },
  { title: 'GitHub', href: github },
];
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="공개 데이터로 금융업무의 질문을 탐색하는 개인 연구 프로젝트" />
    <title>{title ? title + ' | Insight Lab' : 'Insight Lab'}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">본문으로 건너뛰기</a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="wordmark" href={sitePath()} aria-label="Insight Lab 홈"><span aria-hidden="true"></span>Insight Lab</a>
        <nav class="desktop-nav" aria-label="주 메뉴">
          {nav.map(({ title, href }) => <a href={href} aria-current={Astro.url.pathname === href ? 'page' : undefined}>{title}</a>)}
        </nav>
        <a class="mobile-search" href={sitePath('search')}>검색</a>
        <details class="mobile-menu">
          <summary>메뉴</summary>
          <nav aria-label="모바일 주 메뉴">
            {nav.map(({ title, href }) => <a href={href} aria-current={Astro.url.pathname === href ? 'page' : undefined}>{title}</a>)}
          </nav>
        </details>
      </div>
    </header>
    <main id="main" class="container"><slot /></main>
    <footer class="site-footer">
      <div class="container footer-inner">
        <div><strong>Insight Lab</strong><p>Kiwoom Lab 2기 활동</p></div>
        <nav aria-label="푸터 메뉴">
          <a href={sitePath('about')}>About</a><a href={github}>GitHub</a>
          <a href={sitePath('source-policy') + '#data-sources'}>Data Sources</a>
          <a href={sitePath('content-policy')}>Content Policy</a>
          <a href={sitePath('source-policy')}>Source Policy</a>
        </nav>
        <p>Last Updated <time datetime="2026-11-24">2026.11.24</time></p>
      </div>
    </footer>
  </body>
</html>
