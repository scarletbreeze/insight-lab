---
import HashReveal from '../../components/common/HashReveal.astro';
import MarketLayout from '../../components/market/MarketLayout.astro';
import MarketToc from '../../components/market/MarketToc.astro';
import koreanCoverage from '../../../data/market/months/kr-equity-coverage.json';
import priceCoverage from '../../../data/market/months/kr-price-coverage-2024.json';
import raw from '../../../data/market/months/equity-rankings.json';
import krRaw from '../../../data/market/months/kr-equity-rankings.json';
import krAnnual from '../../../data/market/kr-annual-equity-rankings.json';
import spy from '../../../data/market/months/spy-equity-rankings.json';
import annual from '../../../data/market/annual-equity-rankings.json';
import spyAnnual from '../../../data/market/annual-spy-equity-rankings.json';
import { months } from '../../utils/market';
import { sitePath } from '../../utils/paths';

type Market = 'KR' | 'US';
interface Counts { eligibleCount: number; universeCount?: number; priceBasis?: string; }
type Rankings = Record<string, Partial<Record<Market, Counts>>>;
interface Mark { label: string; short: string; data: Counts; totalReturn: boolean; }
/** One cell per period: which markets have a ranking and on which price basis. */
function coverage(primary: Rankings, sp500: Rankings, korea: Rankings) {
  const periods = [...new Set([...Object.keys(primary), ...Object.keys(sp500), ...Object.keys(korea)])].sort();
  return new Map(periods.map((period) => {
    const candidates: Array<[string, string, Counts | undefined]> = [
      ['한국', '한국', primary[period]?.KR ?? korea[period]?.KR],
      ['QQQ', 'QQQ', primary[period]?.US],
      ['SPY', 'SPY', sp500[period]?.US],
    ];
    const marks: Mark[] = candidates.flatMap(([label, short, data]) => data ? [{ label, short, data, totalReturn: data.priceBasis === 'total-return' }] : []);
    return [period, marks];
  }));
}
const monthly = coverage(raw as Rankings, spy as Rankings, krRaw as Rankings);
const yearly = coverage(annual as Rankings, spyAnnual as Rankings, krAnnual as Rankings);
const years = [...new Set([...monthly.keys(), ...yearly.keys()].map((period) => period.slice(0, 4)))].sort().reverse();
const count = (label: string) => [...monthly.values()].filter((marks) => marks.some((mark) => mark.label === label)).length;
const totalReturnMonths = [...monthly].filter(([, marks]) => marks.some((mark) => mark.totalReturn)).map(([period]) => period);
const krMonths = Object.keys(krRaw).sort();
const describe = (marks: Mark[]) => marks.map(({ label, data, totalReturn }) => `${label} ${data.eligibleCount}${data.universeCount ? '/' + data.universeCount : ''}개${totalReturn ? ' 총수익' : ''}`).join(' · ');
const sourceLinks = 16;
---
<MarketLayout title="종목 순위 산정 방식과 수록 범위">
  <Fragment slot="intro">
    <p>한국 순위는 KOSPI 200·KOSDAQ 150 근사 모집단의 원종가(수정주가 미반영, 배당 제외)로, 미국 QQQ·SPY 순위는 분할 조정 종가(배당 제외)로 계산합니다. 표에 ‘총수익’으로 표시한 QQQ {totalReturnMonths.length}개월({totalReturnMonths[0]}~{totalReturnMonths.at(-1)})만 Stooq의 분할·배당 재투자 반영 조정 종가를 쓰므로 다른 달의 가격 수익률과 기준이 다릅니다.</p>
  </Fragment>
  <MarketToc items={[['수록 월', 'months'], ['월별 수익률 산정', 'method'], ['검증 자료와 원자료', 'verification']]} />
  <section class="lab-block" id="months">
    <h2>수록 월</h2>
    <p>한국 {krMonths[0]}~{krMonths.at(-1)} {count('한국')}개월 · QQQ {count('QQQ')}개월 · SPY {count('SPY')}개월. 칸을 선택하면 그 달의 Top 10으로, 마지막 열은 연간 Winner · Loser · Tenbagger로 이동합니다. 셀 설명에 계산 종목 수/모집단 수를 적었습니다. <a href={sitePath('market-time-capsule/methodology') + '#kr-equity'}>산정 기준과 운영자 결정</a></p>
    <div class="lab-table-wrap" role="region" aria-label="연도별·월별 종목 순위 수록 현황" tabindex="0">
      <table class="lab-table lab-table--sticky-first coverage-grid">
        <caption>연도 × 월 수록 현황 · 한국 / QQQ / SPY · ‘총수익’은 Stooq 총수익 기준</caption>
        <thead><tr><th scope="col">연도</th>{months.map((month) => <th scope="col">{Number(month)}월</th>)}<th scope="col">연간</th></tr></thead>
        <tbody>{years.map((year) => <tr>
          <th scope="row">{year}</th>
          {months.map((month) => {
            const period = year + '-' + month;
            const marks = monthly.get(period);
            return <td>{marks && <a href={sitePath('market-time-capsule/' + year + '/' + month) + '#equity-rankings'} title={describe(marks)} aria-label={period + ' · ' + describe(marks)}>
              {marks.map(({ short, totalReturn }) => <span class:list={['mark', 'mark-' + (short === '한국' ? 'kr' : short.toLowerCase()), { 'mark-tr': totalReturn }]}>{short}{totalReturn && <small>총수익</small>}</span>)}
            </a>}</td>;
          })}
          <td>{yearly.get(year) && <a href={sitePath('market-time-capsule/' + year) + '#annual-equity'} title={describe(yearly.get(year) ?? [])} aria-label={year + '년 연간 · ' + describe(yearly.get(year) ?? [])}>
            {yearly.get(year)?.map(({ short }) => <span class:list={['mark', 'mark-' + (short === '한국' ? 'kr' : short.toLowerCase())]}>{short}</span>)}
          </a>}</td>
        </tr>)}</tbody>
      </table>
    </div>
    <p>연간 순위는 해당 연도 첫 거래일의 모집단과 첫날·마지막 날의 분할 조정 종가를 사용하며, 수익률 최고 종목은 Winner, 최저 종목은 Loser, 마지막 종가가 첫 종가의 10배 이상인 종목은 Tenbagger로 표시합니다.{yearly.size === 0 && ' 연간 순위를 공개할 수 있는 가격 자료를 확인 중입니다.'}</p>
  </section>
  <section class="lab-block" id="method">
    <h2>월별 수익률 산정</h2>
    <ol class="lab-list">
      <li>시장별 월 첫 거래일에 해당하는 구성종목을 확정합니다.</li>
      <li>첫 거래일과 마지막 거래일의 분할 조정 종가를 같은 기준으로 확인합니다.</li>
      <li>마지막 조정 종가를 첫 조정 종가로 나눈 뒤 1을 빼고 백분율로 표시합니다.</li>
      <li>가격 수익률의 기본 기준은 배당 제외입니다. 총수익 자료를 사용할 경우 화면에 별도로 표시합니다.</li>
      <li>순위에 모집단과 계산에 포함한 종목 수를 표시합니다. 지수 추종 펀드 보유 목록을 사용할 경우 근사 모집단임을 표시합니다. 현재 구성종목으로 과거를 계산하면 그 사이에 제외된 종목이 빠져 순위가 달라질 수 있습니다.</li>
    </ol>
  </section>
  <section class="lab-block" id="verification">
    <h2>검증 자료와 원자료</h2>
    <details class="lab-fold" id="kr-coverage">
      <summary>한국 ETF 보유 종목의 월별 검증 범위 <span class="lab-fold__count">2024년 {Object.keys(koreanCoverage).length}개월</span></summary>
      <p>2024년 12개월의 첫 거래일에 KOSPI 200·코스닥150을 추종한 두 ETF의 보유 주식을 일별 시세와 대조했습니다. 11월은 미래에셋 TIGER, 다른 달은 삼성 KODEX 명세를 사용했습니다. 첫날과 마지막 날에 거래가 있었고 모든 관측일에 종가가 이어지며 상장주식수가 일정했던 종목 수를 표시합니다. 종목별 Top 10은 운영자의 2026년 11월 27일 발표용 포함 결정에 따라 각 월 화면에 공개합니다.</p>
      <p>네이버 일별 시세로 검사 통과 종목의 월간 수익률을 다시 계산했습니다. 2024년 12개월 모두 상위 10개의 종목과 순서가 일치했습니다. 월별 검사 통과 종목 수의 합은 3,846건으로, 같은 종목이 여러 달에 포함될 수 있습니다.</p>
      <details id="december-price-check"><summary>2024년 12월 상위 10개 순서 교차 검증</summary>
        <p>두 ETF의 월초 보유 주식 353개 중 검사 통과 종목 321개 전부를 네이버 일별 시세로 다시 계산했습니다. 12월 2일 종가에서 30일 종가까지의 수익률로 정렬하자 상위 10개 종목의 순서가 모두 일치했습니다. 상위 10개의 수익률은 두 출처의 계산값 사이에 최대 0.005%p 미만의 차이가 있었습니다.</p>
        <p>이 비교는 321개 안에서의 순서를 검증합니다. 제외한 32개의 기업행동과 종목별 결과의 공개 이용 범위는 추가 확인 대상입니다. <a href="https://github.com/FinanceData/marcap/tree/master/data">연도별 시세</a> · <a href="https://api.finance.naver.com/siseJson.naver?symbol=005930&amp;requestType=1&amp;startTime=20241202&amp;endTime=20241230&amp;timeframe=day">네이버 일별 시세 예시</a></p>
      </details>
      <ul class="coverage-months" aria-label="월별 국내 ETF 보유 종목 검증 통과율">
        {Object.entries(koreanCoverage).map(([period, row]) => (
          <li><a href={'#coverage-' + period}>
            <span>{Number(period.slice(-2))}월 · {row.provider}</span>
            <strong>{(row.eligible / row.universe * 100).toFixed(1)}%</strong>
            <meter min="0" max={row.universe} value={row.eligible} aria-label={period + ' 검증 통과 종목 비중'}></meter>
          </a></li>
        ))}
      </ul>
      <div class="lab-table-wrap" role="region" aria-label="월별 ETF 보유 주식과 가격 대조 결과" tabindex="0"><table class="lab-table lab-table--sticky-first">
        <caption>월별 ETF 보유 주식과 가격 대조 결과 · 종목 수</caption>
        <thead><tr><th scope="col">기간</th><th scope="col">보유 주식</th><th scope="col">검사 통과</th><th scope="col">시세 재대조 · 상위 순위 일치</th><th scope="col">추가 확인</th><th scope="col">보유 명세 원문</th></tr></thead>
        <tbody>{Object.entries(koreanCoverage).map(([period, row]) => <tr id={'coverage-' + period}>
          <th scope="row"><a href={sitePath('market-time-capsule/' + period.replace('-', '/')) + '#equity-rankings'}>{row.first}~{row.last}</a></th>
          <td>{row.universe}</td><td>{row.eligible}</td><td>{row.priceCrossCheck.covered}개 · {row.priceCrossCheck.matchedRanks}/10위</td><td data-wrap>{Object.entries(row.excluded).map(([reason, count]) => <div>{reason} · {count}개</div>)}</td>
          <td><a href={row.holdingsSources[0]}>{row.provider} 200</a> · <a href={row.holdingsSources[1]}>{row.provider} 코스닥150</a></td>
        </tr>)}</tbody>
      </table></div>
    </details>
    <details class="lab-fold" id="kr-price-coverage">
      <summary>2024년 국내 월초 상장 종목 시세 점검 <span class="lab-fold__count">{Object.keys(priceCoverage).length}개월</span></summary>
      <p>각 월 첫 거래일에 KOSPI·KOSDAQ(KOSDAQ GLOBAL 포함) 시세 파일에 등장한 종목코드를 추적했습니다. 검사 통과는 첫날·마지막 날 거래량이 양수이고 매 관측일에 종가가 있고 전일 종가와 기준가격이 이어지며 상장주식수가 일정했다는 뜻입니다. ETF 편입 여부는 별도로 확인합니다.</p>
      <div class="lab-table-wrap" role="region" aria-label="월초 상장 종목의 시세 점검 결과" tabindex="0"><table class="lab-table lab-table--sticky-first">
        <caption>월초 종목코드 기준 · 종목 수</caption>
        <thead><tr><th scope="col">월</th><th scope="col">월초 종목</th><th scope="col">통과</th><th scope="col">추가 확인 사유</th></tr></thead>
        <tbody>{Object.entries(priceCoverage).map(([period,row]) => <tr>
          <th scope="row"><a href={sitePath('market-time-capsule/' + period.replace('-', '/')) + '#equity-rankings'}>{period}</a></th>
          <td>{row.opening}</td><td>{row.passed}</td><td data-wrap>{Object.entries(row.excluded).map(([reason,count]) => <div>{reason} · {count}개</div>)}</td>
        </tr>)}</tbody>
      </table></div>
      <p><a href="https://github.com/FinanceData/marcap/tree/master/data">FinanceData marcap 연도별 시세 파일</a></p>
    </details>
    <details class="lab-fold" id="sources">
      <summary>원자료 <span class="lab-fold__count">출처 {sourceLinks}건</span></summary>
      <div class="lab-grid">
        <section class="lab-card">
          <h3>한국</h3>
          <p>KOSPI 200과 KOSDAQ 150의 당시 구성종목 및 해당일 가격을 확인합니다.</p>
          <p>2024년 12월 2일과 30일의 국내 원종가 5,482행을 일괄 조회했습니다. 당시 ETF 보유 종목 353개를 대조한 결과, {koreanCoverage['2024-12'].eligible}개가 거래량·종가 연속성·상장주식수 검사를 통과했습니다. 월별 검증 표에서 나머지 종목의 제외 사유를 확인할 수 있습니다.</p>
          <p>지수 순위 산정에는 당시의 공식 편입 목록과 기업행동을 반영한 가격이 필요합니다. 공식 편입 목록이 없는 달은 월초 시가총액 상위 종목을 근사 모집단으로 사용하고, 기업행동은 가격을 조정하지 않고 해당 종목을 제외하는 방식으로 대신합니다.</p>
          <ul class="lab-list">
            <li><a href="https://data.krx.co.kr/contents/MDC/STAT/standard/MDCSTAT006.jsp">KRX 지수 구성종목</a></li>
            <li><a href="https://www.kif.re.kr/KIF/Publication/OthersDetail.aspx?ControlNo=342019&amp;NodeID=402">2024년 12월 지수 정기 변경 발표</a></li>
            <li><a href="https://data.krx.co.kr/contents/MDC/MDI/outerLoader/index.cmd?screenId=MDCSTAT015">KRX 전종목 시세</a></li>
            <li><a href="https://github.com/FinanceData/marcap/tree/master/data">연도별 종가 검증 자료</a></li>
          </ul>
        </section>
        <section class="lab-card">
          <h3>미국</h3>
          <p>Nasdaq-100을 추종하는 QQQ와 S&P 500을 추종하는 SPY의 보유 명세 및 편입 공지로 모집단을 구성합니다. 각 모집단의 순위를 표시합니다. WIKI의 가격 범위가 부족하거나 분할 비율로 조정할 수 없는 기업행동이 발생한 경우, 제외 사유와 종목을 결과에 표시합니다.</p>
          <ul class="lab-list">
            <li><a href="https://www.sec.gov/Archives/edgar/data/1067839/000110465909005352/a08-28674_2n30b2.htm">QQQ 2008년 9월 말 보유 명세</a></li>
            <li><a href="https://www.sec.gov/Archives/edgar/data/1067839/000110465915002429/a14-24967_1n30b2.htm">QQQ 2014년 9월 말 보유 명세</a></li>
            <li><a href="https://www.sec.gov/Archives/edgar/data/1067839/000119312516441831/d106822d485bpos.htm">QQQ 2015년 9월 말 보유 명세</a></li>
            <li><a href="https://www.sec.gov/Archives/edgar/data/1067839/000119312516806695/d272217dn30b2.htm">QQQ 2016년 9월 말 보유 명세</a></li>
            <li><a href="https://www.sec.gov/Archives/edgar/data/1067839/000119312518001208/d432220dn30b2.htm">QQQ 2017년 9월 말 보유 명세</a></li>
            <li><a href="https://www.sec.gov/Archives/edgar/data/884394/000119312517355427/d418234dn30d.htm">SPY 2017년 9월 말 보유 명세</a></li>
            <li><a href="https://www.sec.gov/Archives/edgar/data/884394/000119312517183633/d280941dn30d.htm">SPY 2017년 3월 말 보유 명세</a></li>
            <li><a href="https://www.sec.gov/Archives/edgar/data/884394/000119312516777823/d235904dn30d.htm">SPY 2016년 9월 말 보유 명세</a></li>
            <li><a href="https://data.nasdaq.com/databases/WIKIP">Nasdaq Data Link WIKI/PRICES</a></li>
            <li><a href="https://www.sec.gov/data-research/sec-markets-data/form-n-port-data-sets">SEC Form N-PORT 데이터셋</a></li>
            <li><a href="https://www.sec.gov/Archives/edgar/data/884394/000175272425043826/NPORT_J905_96606633_1224.htm">SPY 2024년 말 보유 명세</a></li>
            <li><a href="https://www.sec.gov/Archives/edgar/data/1067839/000175272425039757/edgar.htm">QQQ 2024년 말 보유 명세</a></li>
          </ul>
        </section>
      </div>
    </details>
  </section>
  <a class="lab-top-link" href="#top">맨 위로 ↑</a>
  <HashReveal />
</MarketLayout>


<style>
  .coverage-grid th, .coverage-grid td { padding: .3rem .35rem; font-size: .8rem; white-space: nowrap; }
  .coverage-grid td { text-align: center; vertical-align: middle; }
  .coverage-grid td a { display: inline-flex; flex-wrap: wrap; justify-content: center; gap: .15rem; text-decoration: none; }
  .mark { display: inline-block; padding: 0 .3rem; border-radius: .25rem; font-size: .72rem; font-weight: 650; line-height: 1.5; border: 1px solid transparent; }
  .mark-kr { background: rgba(200, 81, 55, .14); color: var(--color-ink); }
  .mark-qqq { background: rgba(53, 128, 192, .16); color: var(--color-ink); }
  .mark-spy { background: rgba(57, 118, 99, .16); color: var(--color-ink); }
  .mark-tr { border-color: currentColor; }
  .mark small { display: block; font-size: .6rem; font-weight: 500; line-height: 1.2; }
  .coverage-months { display:grid; grid-template-columns:repeat(auto-fit,minmax(min(100%,8rem),1fr)); gap:.5rem; list-style:none; padding:0; }
  .coverage-months a { display:grid; gap:.3rem; padding:.65rem; border:1px solid var(--color-rule); border-radius:.4rem; }
  .coverage-months meter { width:100%; }
  tr:target { outline:2px solid currentColor; outline-offset:-2px; scroll-margin-top:5rem; }
</style>
