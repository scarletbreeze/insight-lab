---
import MarketLayout from '../../components/market/MarketLayout.astro';
import MarketPeriodCompare from '../../components/market/MarketPeriodCompare';
import data from '../../../data/market/months/snapshots.json';
import { sitePath } from '../../utils/paths';
import { gold, koreaAnnualCloses, koreaAnnualSource, koreaMonthlyCloses, marketEvents, months, usMonthlyCloses, years } from '../../utils/market';

type SeriesId = keyof typeof data.series;
const ids = Object.keys(data.series) as SeriesId[];
const measures = [
  ...ids.map((id) => ({ id, ...data.series[id], sourceUrl: 'https://fred.stlouisfed.org/series/' + id })),
  { id: 'gold', label: '금 가격 · 월평균', unit: 'USD/트로이온스', changeUnit: 'USD/트로이온스', sourceUrl: gold.sourceUrl },
  { id: 'kospi', label: 'KOSPI · 월말 종가', unit: 'p', changeUnit: 'p' },
  { id: 'kosdaq', label: 'KOSDAQ · 월말 종가', unit: 'p', changeUnit: 'p' },
  { id: 'sp500', label: 'S&P 500 · 월말 종가', unit: 'p', changeUnit: 'p' },
  { id: 'nasdaq', label: 'Nasdaq Composite · 월말 종가', unit: 'p', changeUnit: 'p' },
  { id: 'kospi-return', label: 'KOSPI · 월간 등락률', unit: '%', changeUnit: '%p' },
  { id: 'kosdaq-return', label: 'KOSDAQ · 월간 등락률', unit: '%', changeUnit: '%p' },
  { id: 'sp500-return', label: 'S&P 500 · 월간 등락률', unit: '%', changeUnit: '%p' },
  { id: 'nasdaq-return', label: 'Nasdaq Composite · 월간 등락률', unit: '%', changeUnit: '%p' },
];
function indexReturn(snapshot: (typeof koreaMonthlyCloses)[string], index: number) {
  if (!snapshot) return null;
  const first = snapshot.first[index];
  const last = snapshot.last[index];
  if (!first || last == null) return null;
  const date = snapshot.firstDate + ' ~ ' + snapshot.lastDate;
  return { value: (last / first - 1) * 100, date };
}
const observations = data.months as Record<string, Partial<Record<SeriesId, { last: number; lastDate: string }>> | undefined>;
const eventsByMonth = Map.groupBy(marketEvents, ({ date }) => date.slice(0, 7));
const periods = years.flatMap((year) => months.map((month) => {
  const id = year + '-' + month;
  const rows = observations[id];
  const monthly = koreaMonthlyCloses[id];
  const us = usMonthlyCloses[id];
  const annual = month === '12' ? koreaAnnualCloses[year] : undefined;
  const closes = monthly?.last ?? annual;
  const indexDate = monthly?.lastDate ?? year + '년 말';
  const indexSource = monthly?.lastSource ?? (annual ? koreaAnnualSource(year) : undefined);
  const goldValue = gold.months[id];
  return {
    id,
    observations: [
      ...ids.map((symbol) => rows?.[symbol] ? { value: rows[symbol].last, date: rows[symbol].lastDate } : null),
      goldValue == null ? null : { value: goldValue, date: id + ' 평균' },
      ...[0, 1].map((index) => {
        const value = closes?.[index];
        return value == null ? null : { value, date: indexDate, source: indexSource };
      }),
      ...[0, 1].map((index) => us ? { value: us.last[index], date: us.lastDate, source: us.lastSource } : null),
      ...[monthly, us].flatMap((snapshot) => [0, 1].map((index) => indexReturn(snapshot, index))),
    ],
    events: (eventsByMonth.get(id) ?? []).map(({ title, date, sourceUrl }) => ({ title, date, sourceUrl })),
  };
}));
---
<MarketLayout title="두 달의 시장 비교">
  <p slot="intro">두 달을 골라 한국·미국 지수의 종가와 등락률, 국채금리, WTI, 원·달러 환율과 금 가격을 비교합니다.</p>
  <section class="lab-block">
    <p>월간 지수 등락률은 첫 거래일 종가에서 마지막 거래일 종가까지의 변화입니다. 각 월의 종가 출처와 사건은 월 상세에서 확인할 수 있습니다.</p>
    <MarketPeriodCompare client:load {periods} {measures} base={sitePath('market-time-capsule')} />
  </section>
</MarketLayout>
