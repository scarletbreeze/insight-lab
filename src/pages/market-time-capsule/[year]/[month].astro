---
import MarketLayout from '../../../components/market/MarketLayout.astro';
import MarketSnapshot from '../../../components/market/MarketSnapshot.astro';
import EventList from '../../../components/market/EventList.astro';
import { years, months, marketEvents } from '../../../utils/market';
import { sitePath } from '../../../utils/paths';

export function getStaticPaths() {
  return years.flatMap((year) => months.map((month) => ({ params: { year: String(year), month }, props: { year, month } })));
}

const { year, month } = Astro.props;
const items = marketEvents.filter(({ date }) => date.startsWith(year + '-' + month));
const then = items.flatMap((item) => item.then ? [item.then] : []);
const now = items.flatMap((item) => item.now ? [item.now] : []);
---
<MarketLayout title={`${year}년 ${Number(month)}월`} {year}>
  <p slot="intro"><a class="lab-link" href={sitePath('market-time-capsule/' + year)}>{year}년으로 돌아가기</a></p>
  <section class="lab-block"><h2>주요 사건</h2><EventList {items} /></section>
  <section class="lab-block"><h2>시장 스냅샷</h2><MarketSnapshot period={year + "-" + month} /></section>
  <section class="lab-block"><h2>한국·미국 수익률 Top 10</h2><p class="empty-state">자료 확인 중</p></section>
  <div class="lab-grid">
    {[[ 'THEN · 당시 알 수 있었던 사실', then ], [ 'NOW · 이후 확인된 사실', now ]].map(([label, facts]) => (
      <section class="lab-block lab-card">
        <h2>{label}</h2>
        {Array.isArray(facts) && facts.length ? <ul>{facts.map((fact) => <li>{fact}</li>)}</ul> : <p>자료 확인 중</p>}
      </section>
    ))}
  </div>
</MarketLayout>
