---
import monthNotes from '../../../../data/market/month-notes.json';
import MarketLayout from '../../../components/market/MarketLayout.astro';
import PeriodNavigation from '../../../components/market/PeriodNavigation.astro';
import MarketSnapshot from '../../../components/market/MarketSnapshot.astro';
import IndexSnapshot from '../../../components/market/IndexSnapshot.astro';
import GoldSnapshot from '../../../components/market/GoldSnapshot.astro';
import EquityRankings from '../../../components/market/EquityRankings.astro';
import EventList from '../../../components/market/EventList.astro';
import { years, months, marketEvents } from '../../../utils/market';

export function getStaticPaths() {
  return years.flatMap((year) => months.map((month) => ({ params: { year: String(year), month }, props: { year, month } })));
}

const { year, month } = Astro.props;
const period = year + '-' + month;
const note = monthNotes[period as keyof typeof monthNotes];
const study = note && 'publishedStudy' in note ? note.publishedStudy : undefined;
const items = marketEvents.filter(({ date }) => date.startsWith(period));
const sources = [...new Map(items.map(({ sourceName, sourceUrl }) => [sourceUrl, sourceName])).entries()];
const then = items.flatMap(({ then, sourceUrl }) => then ? [{ fact: then, sourceUrl }] : []);
const now = items.flatMap(({ now, nowSourceUrl, sourceUrl }) => now ? [{ fact: now, sourceUrl: nowSourceUrl ?? sourceUrl }] : []);
const notes = [
  { label: 'THEN · 당시 알 수 있었던 사실', facts: then },
  { label: 'NOW · 이후 확인된 사실', facts: now },
];
---
<MarketLayout title={`${year}년 ${Number(month)}월`} {year}>
  {note && <p slot="intro">{note.summary}</p>}
  <PeriodNavigation {year} {month} />
  <section class="lab-block">
    <h2>시장 스냅샷</h2>
    <MarketSnapshot {period} />
    <GoldSnapshot {period} />
  </section>
  <IndexSnapshot {period} />
  <IndexSnapshot {period} market="US" />
  <section class="lab-block" id="equity-rankings"><h2>한국·미국 수익률 Top 10</h2><EquityRankings {period} /></section>
  {study && <section class="lab-block">
    <h2>공개 시장 리뷰</h2>
    <article class="lab-card">
      <h3>{study.title}</h3>
      <p>{study.method}</p>
      <ul class="lab-list">{study.findings.map((finding) => <li>{finding}</li>)}</ul>
      <a href={study.sourceUrl}>{study.sourceName}</a>
    </article>
  </section>}
  <section class="lab-block"><h2>주요 사건</h2><EventList {items} /></section>
  <div class="lab-grid">
    {notes.map(({ label, facts }) => (
      <section class="lab-block lab-card">
        <h2>{label}</h2>
        {facts.length ? <ul class="lab-list">{facts.map(({ fact, sourceUrl }) => <li>
          <p>{fact}</p>
          <a href={sourceUrl}>출처</a>
        </li>)}</ul> : <p>자료 확인 중</p>}
      </section>
    ))}
  </div>
  {note && <section class="lab-block">
    <h2>Returner Memo</h2>
    <p>{note.memo}</p>
    <a href={note.sourceUrl}>{note.sourceName}</a>
  </section>}
  {sources.length > 0 && <section class="lab-block">
    <h2>이달의 사건 출처</h2>
    <ul class="lab-list">{sources.map(([url, name]) => <li><a href={url}>{name}</a></li>)}</ul>
  </section>}
</MarketLayout>
