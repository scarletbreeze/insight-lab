---
import MarketLayout from '../../components/market/MarketLayout.astro';
import equityRankings from '../../../data/market/months/equity-rankings.json';
import spyRankings from '../../../data/market/months/spy-equity-rankings.json';
import annualRankings from '../../../data/market/annual-equity-rankings.json';
import krRankings from '../../../data/market/months/kr-equity-rankings.json';
import krAnnualRankings from '../../../data/market/kr-annual-equity-rankings.json';
import { years, marketEvents } from '../../utils/market';
import { sitePath } from '../../utils/paths';

const documented = new Set(marketEvents.map(({ date }) => Number(date.slice(0, 4))));
const rankedMonths = Object.keys(equityRankings).sort();
const rankedYears = Object.keys(annualRankings).sort();
const spyMonths = Object.keys(spyRankings).sort();
const krMonths = Object.keys(krRankings).sort();
const krYears = Object.keys(krAnnualRankings).sort();
const monthLabel = (period: string) => {
  const [year, month] = period.split('-');
  return year + '년 ' + Number(month) + '월';
};
function periodRanges(periods: string[]) {
  const groups: string[][] = [];
  let previous = -1;
  for (const period of periods) {
    const [year, month] = period.split('-').map(Number);
    const index = year * 12 + month;
    if (index !== previous + 1) groups.push([]);
    groups[groups.length - 1].push(period);
    previous = index;
  }
  return groups.map((group) => group.length > 1
    ? monthLabel(group[0]) + '~' + monthLabel(group[group.length - 1])
    : monthLabel(group[0])).join(', ');
}
---
<MarketLayout title="Market Time Capsule">
  <p slot="intro">과거로 돌아간다면, 그 시대의 무엇을 기억하고 싶을까?</p>
  <section class="lab-block">
    <h2>1990–2026 연도별 탐색</h2>
    <ul class="lab-chips">{years.map((year) => <li><a href={sitePath('market-time-capsule/' + year)}>{year}</a></li>)}</ul>
    <p>{documented.size}개 연도에 시장 사건 {marketEvents.length}건을 수록했습니다.</p>
    <p>한국·미국 4개 지수의 월별 등락 · <a href={sitePath('market-time-capsule/2020') + '#index-calendar'}>2020년</a> · <a href={sitePath('market-time-capsule/2024') + '#index-calendar'}>2024년</a></p>
    <p><a href={sitePath('market-time-capsule/2025')}>2025년 12개월 시장 기록 보기</a> · 한국·미국 지수 종가와 주요 사건</p>
  </section>
  <section class="lab-block">
    <h2>시장 지표 추이</h2>
    <p>한 지표를 골라 최대 10년의 흐름을 살펴봅니다.</p>
    <a href={sitePath('market-time-capsule/trends')}>시장 지표 그래프 보기</a>
    <p><a href={sitePath("market-time-capsule/compare")}>서로 다른 두 달 비교하기</a></p>
  </section>
  <section class="lab-block">
    <h2>종목 수익률과 검증 범위</h2>
    <p><a href={sitePath('market-time-capsule/2024') + '#annual-equity'}>2024년 국내 ETF 보유 종목의 연간 검증 결과</a> · <a href={sitePath('market-time-capsule/equity-data') + '#kr-price-coverage'}>국내 월별 시세 점검표</a></p>
    {krMonths.length > 0 && <p>한국은 월초 시가총액 상위 KOSPI 200·KOSDAQ 150 근사 모집단(2024년은 ETF 보유 명세 기준)으로 {periodRanges(krMonths)}의 월간 Top 10 {krMonths.length}개월과 {krYears[0]}~{krYears[krYears.length - 1]}년 연간 Winner·Loser {krYears.length}개 연도를 수록했습니다. 수정주가 미반영 · <a href={sitePath('market-time-capsule/methodology') + '#kr-equity'}>산정 기준</a></p>}
    <p>QQQ 보유 주식을 기준으로 {periodRanges(rankedMonths)}의 월간 수익률 {rankedMonths.length}개월을 수록했습니다.</p>
    {spyMonths.length > 0 && <p>SPY 기준은 {periodRanges(spyMonths)} {spyMonths.length}개월을 수록했습니다.</p>}
    <ul class="lab-chips">
      {rankedYears.map((year) => <li><a href={sitePath('market-time-capsule/' + year)}>{year}년 연간 수익률과 월별 순위</a></li>)}
      <li><a href={sitePath('market-time-capsule/equity-data')}>종목 순위 산정 방식과 수록 범위</a></li>
    </ul>
  </section>
  <section class="lab-block">
    <h2>Returner Mode</h2>
    <p>출처가 있는 시장 사건을 바탕으로 한 10문제 역사 퀴즈</p>
    <a href={sitePath('market-time-capsule/game')}>퀴즈 시작</a>
  </section>
</MarketLayout>
