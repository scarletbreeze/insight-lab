---
import HeroLayout from '../../components/hero/HeroLayout.astro';
import ScreenCard from '../../components/hero/ScreenCard.astro';
import { interests, purposes, screenGuides, screens, styles } from '../../utils/hero';

const options = [
  { name: 'purpose', label: '목적', values: purposes },
  { name: 'style', label: '투자 스타일', values: styles },
  { name: 'interest', label: '분석 관심사', values: interests },
  { name: 'product', label: '상품', values: [...new Set(screens.map((screen) => screen.product))] },
  { name: 'screenType', label: '화면 유형', values: [...new Set(screens.map((screen) => screen.screenType))] },
  { name: 'level', label: '난이도', values: [...new Set(screens.map((screen) => screen.level))] },
  { name: 'guide', label: '화면 이미지', values: ['공식 가이드 있음'] },
];
---
<HeroLayout title="화면 탐색">
  <p slot="intro">화면번호, 화면명, 관심사로 영웅문4 화면을 찾으세요. 투자 스타일과 난이도는 Hero Lab의 편집 분류입니다.</p>
  <hero-discovery>
    <form class="hero-finder">
      <label for="hero-query">화면 검색</label>
      <input id="hero-query" name="q" type="search" placeholder="예: 0130, 관심종목, 수급" />
      <div class="hero-filters">
        {options.map(({ name, label, values }) => (
          <label>{label}
            <select name={name}>
              <option value="">전체</option>
              {values.map((value) => <option value={value}>{value}</option>)}
            </select>
          </label>
        ))}
      </div>
      <button type="reset">필터 초기화</button>
    </form>
    <p class="hero-status" role="status">{screens.length}개 화면</p>
    <div class="hero-grid">
      {screens.map((screen) => {
        const guide = screenGuides[screen.number];
        const keywords = [screen.number, screen.title, screen.summary, ...screen.tags, ...(guide?.sections?.flat() ?? [])];
        return <div data-result data-search={keywords.join(' ')}
          data-purpose={screen.purpose} data-style={screen.styles.join('|')} data-interest={screen.tags.join('|')}
          data-screen-type={screen.screenType} data-product={screen.product} data-level={screen.level}
          data-guide={guide?.image ? '공식 가이드 있음' : undefined}>
          <ScreenCard screen={screen} />
        </div>;
      })}
    </div>
    <p class="empty-state" data-empty hidden>일치하는 화면이 없습니다. 검색어나 필터를 바꿔보세요.</p>
  </hero-discovery>
</HeroLayout>
<script>
  class HeroDiscovery extends HTMLElement {
    private controller?: AbortController;

    connectedCallback() {
      const form = this.querySelector('form');
      const status = this.querySelector('[role="status"]');
      const empty = this.querySelector<HTMLElement>('[data-empty]');
      if (!form || !status || !empty) return;

      this.controller = new AbortController();
      const { signal } = this.controller;
      const entries = Array.from(this.querySelectorAll<HTMLElement>('[data-result]'));
      const fields = Array.from(form.querySelectorAll<HTMLInputElement | HTMLSelectElement>('[name]'));
      const filterNames = Array.from(form.querySelectorAll('select[name]'), (field) => field.getAttribute('name')!);

      function render() {
        if (!form || !status || !empty) return;
        const criteria = new FormData(form);
        const query = String(criteria.get('q')).toLowerCase().trim();
        const words = query ? query.split(/\s+/) : [];
        let count = 0;

        for (const entry of entries) {
          const matchesQuery = words.every((word) => entry.dataset.search?.toLowerCase().includes(word));
          const matchesFilters = filterNames.every((field) => {
            const value = String(criteria.get(field));
            return !value || entry.dataset[field]?.split('|').includes(value);
          });
          entry.hidden = !(matchesQuery && matchesFilters);
          if (!entry.hidden) count++;
        }

        status.textContent = `${count}개 화면`;
        empty.hidden = count > 0;
      }

      function readUrl() {
        const parameters = new URLSearchParams(location.search);
        for (const field of fields) {
          const value = parameters.get(field.name) ?? '';
          field.value = field instanceof HTMLInputElement || Array.from(field.options).some((option) => option.value === value) ? value : '';
        }
        render();
      }

      function update() {
        if (signal.aborted) return;
        const url = new URL(location.href);
        for (const field of fields) {
          const value = field.value.trim();
          if (value) url.searchParams.set(field.name, value);
          else url.searchParams.delete(field.name);
        }
        if (url.href !== location.href) history.replaceState(history.state, '', url);
        render();
      }

      form.addEventListener('input', update, { signal });
      form.addEventListener('submit', (event) => event.preventDefault(), { signal });
      form.addEventListener('reset', () => requestAnimationFrame(update), { signal });
      window.addEventListener('popstate', readUrl, { signal });
      readUrl();
    }

    disconnectedCallback() {
      this.controller?.abort();
    }
  }
  customElements.define('hero-discovery', HeroDiscovery);
</script>
