---
import HeroLayout from '../../components/hero/HeroLayout.astro';
import { sitePath } from '../../utils/paths';
import { essentials, legends, screenByNumber, workflows } from '../../utils/hero';
import type { EssentialCriterion } from '../../utils/hero';
import mentions from '../../../data/voc/screen-mentions.json';
const ranked = Object.entries(mentions.screens).sort(([a, x], [b, y]) => y - x || a.localeCompare(b));
const inquiries = Object.values(mentions.years).reduce((sum, year) => sum + year.categories['문의'], 0);
const cutoff = ranked[9]?.[1] ?? 0;
const leaders = ranked.filter(([, count]) => count >= cutoff);
const remaining = ranked.filter(([, count]) => count < cutoff);

const essentialScreens = essentials.screens.map((entry) => ({ ...entry, screen: screenByNumber(entry.screenNo) }));
const evidenceHref = (url: string) => {
  if (/^https?:/.test(url)) return url;
  const [path, hash] = url.split('#');
  return sitePath(path) + (hash ? '#' + hash : '');
};
---
<HeroLayout title="Hall of Fame">
  <section class="hero-section">
    <h2>Hero Essential</h2>
    <p>{essentials.rule} 기준별 근거는 공식 가이드·도움말, 『{legends.book.title}』 프로필, 추천 조합과 공식 도움말의 화면 연결, 공개 문의 제목의 화면번호 언급 건수입니다.</p>
    <div class="hero-grid">
      {essentialScreens.map(({ screen, reason, criteria, evidence }) => (
        <article class="hero-card hero-essential">
          <span class="category">{screen.number} · {screen.purpose}</span>
          <a href={sitePath('hero-lab/screens/' + screen.number)}><strong>{screen.title}</strong></a>
          <p>{reason}</p>
          <ul class="hero-chips hero-criteria" aria-label="선정 기준">
            {criteria.map((key) => <li>{essentials.criteria[key as EssentialCriterion]}</li>)}
          </ul>
          <details>
            <summary>근거 {evidence.length}개</summary>
            <ul>{evidence.map(({ label, url }) => <li><a href={evidenceHref(url)}>{label}</a></li>)}</ul>
          </details>
        </article>
      ))}
    </div>
  </section>
  <section class="hero-section" id="screen-mentions">
    <h2>Most Asked · 문의 제목에 나온 화면</h2>
    <p>{mentions.start}~{mentions.end} 공개 문의 {inquiries.toLocaleString('ko-KR')}건 중 {mentions.matchedThreads.toLocaleString('ko-KR')}건의 제목에서 집계 대상 {mentions.catalogSize}개 화면번호 중 하나 이상을 확인했습니다. 대괄호 안의 번호 또는 ‘화면’과 함께 쓴 번호를 셌습니다. 같은 문의에 같은 번호가 반복되면 한 번만 셉니다.</p>
    <ul class="hero-chips">{leaders.map(([number, count]) => <li><a href={sitePath('hero-lab/screens/' + number)}>{number} {screenByNumber(number).title} · {count}건</a></li>)}</ul>
    {remaining.length > 0 && <details><summary>다른 화면 {remaining.length}개</summary>
      <ul class="hero-chips">{remaining.map(([number, count]) => <li><a href={sitePath('hero-lab/screens/' + number)}>{number} {screenByNumber(number).title} · {count}건</a></li>)}</ul>
    </details>}
    <a href={mentions.sourceUrl}>키움증권 공개 고객게시판</a>
  </section>
  <section class="hero-section">
    <h2>Legend’s Pick</h2>
    <p>『{legends.book.title}』 · {legends.book.author} · {legends.book.publisher}</p>
    <p>종이책 {legends.book.printDate} · 전자책 {legends.book.ebookDate}</p>
    <p>공개 목차와 소개를 바탕으로 장별 접근을 요약했습니다. 함께 볼 화면과 복기 질문은 Hero Lab이 구성한 학습 자료입니다.</p>
    <div class="hero-grid">
      {legends.profiles.map((profile) => (
        <article class="hero-card" id={'legend-' + profile.chapter}>
          <span class="category">{profile.style}</span>
          <strong>{profile.name}</strong>
          <p>{profile.summary}</p>
          <a href={legends.book.contentsUrl}>도서 목차 · {profile.chapter}장</a>
          <p>함께 볼 화면</p>
          <ul class="hero-chips">
            {profile.screens.map((number) => (
              <li><a href={sitePath('hero-lab/screens/' + number)}>{number} {screenByNumber(number).title}</a></li>
            ))}
          </ul>
          <details><summary>화면으로 복기하기</summary>
            <p>{profile.exercise}</p>
            {workflows.filter(({ chapter }) => chapter === profile.chapter).map(({ slug, title }) =>
              <p><a href={sitePath('hero-lab/recipes') + '#' + slug}>{title}</a></p>)}
          </details>
        </article>
      ))}
    </div>
    <p><a href={legends.book.ebookUrl}>전자책 정보</a></p>
  </section>
</HeroLayout>
