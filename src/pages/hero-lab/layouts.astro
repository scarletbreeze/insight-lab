---
import HeroLayout from '../../components/hero/HeroLayout.astro';
import LayoutPlanner from '../../components/hero/LayoutPlanner';
import layouts from '../../../data/hero/layouts.json';
import { screenByNumber, workflows } from '../../utils/hero';
import { sitePath } from '../../utils/paths';

const numbers = new Set([
  ...Object.values(layouts.style).flat(), ...Object.values(layouts.focus),
  ...Object.values(layouts.derivativeFocus), ...Object.values(layouts.overseasFocus),
  ...workflows.flatMap(({ steps }) => steps.map(({ number }) => number)),
]);
const cards = Object.fromEntries([...numbers].map(number => {
  const { title, screenType } = screenByNumber(number);
  return [number, { title, screenType }];
}));
---
<HeroLayout title="Layout Lab">
  <p slot="intro">추천 조합이나 투자 스타일을 골라 영웅문 화면을 모니터 1~3대에 배치해 보세요.</p>
  <LayoutPlanner client:load cards={cards} screenBase={sitePath('hero-lab/screens')} recipeBase={sitePath('hero-lab/recipes')} />
</HeroLayout>
