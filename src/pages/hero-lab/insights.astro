---
import HeroLayout from '../../components/hero/HeroLayout.astro';
import { heroGuides, screenByNumber } from '../../utils/hero';
import { sitePath } from '../../utils/paths';

const insights = [
  {
    title: '창구 순위와 투자자별 매매를 읽는 순서',
    summary: '종목별증권사순위는 거래를 중개한 증권사 단위로, 종목별 기관매매추이는 투자 주체별로 집계합니다. 두 화면의 날짜를 맞춘 뒤 각각의 순매수를 읽어야 외국계 창구 거래와 외국인 거래를 혼동하지 않습니다.',
    screens: ['0251', '0246', '0258'],
  },
  {
    title: 'ETF의 가격과 구성 비중 확인',
    summary: '전체시세에서 같은 추적지수를 고르고 구성종목에서 편입 종목과 표시 비중을 비교합니다. 키움 도움말은 일부 ETF의 구성 비중이 실제 값과 다를 수 있다고 안내합니다. 과거 비중을 복기할 때는 해당 날짜의 운용사 명세를 함께 확인합니다.',
    screens: ['0278', '0275', '0276'],
  },
  {
    title: '미체결 수량에서 결제 예정액까지',
    summary: '실시간 미체결은 주문에서 남은 수량을 보여줍니다. 체결확인에서 당일 정정·취소를 포함한 기록을 대조하고, 결제예정내역상세에서 결제일별 추정예수금을 따로 봅니다.',
    screens: ['0341', '0350', '0348'],
  },
  {
    title: '거래량 급증과 평균 거래량 갱신',
    summary: '0168은 전일이나 기준 분의 거래량과 비교하고, 0169는 선택한 기간의 평균 거래량을 기준으로 종목을 찾습니다. 같은 종목이 두 목록에 있는지 확인하면 장중 급증과 여러 날의 평균을 넘어선 경우를 구별할 수 있습니다.',
    screens: ['0168', '0169', '0143'],
  },
  {
    title: '업종의 장중 움직임과 누적 수급',
    summary: '업종현재가에서 오늘 움직임을 확인하고, 기간별 업종 시세와 수급에서 같은 업종의 5일·20일 흐름을 비교합니다. 업종종합차트를 열어 확인한 기간의 지수 흐름을 다시 봅니다.',
    screens: ['0211', '0219', '0602'],
  },
  {
    title: '시장 강도와 투자 주체',
    summary: '등락률과 투자자별 매매는 조회 시장과 시각을 맞춰 비교합니다. [0780]은 조회 버튼으로 수치를 갱신하므로 차트의 시점과 따로 확인합니다.',
    screens: ['0641', '0780', '0130'],
  },
  {
    title: '재무 실적과 가격의 비교',
    summary: '기업분석에서 사업과 재무제표를 읽은 뒤 재무차트에서 가격과 재무지표의 추이를 함께 봅니다. 분기와 연간 기준을 맞추고 예상치는 화면 표시로 구분합니다.',
    screens: ['0919', '0604'],
  },
  {
    title: '체결 내역과 호가 비교',
    summary: '호가창의 대기 잔량과 체결분석의 실제 거래량은 각각 다른 정보를 보여줍니다. 체결금액 구간과 가격 구간을 바꿔 보면 어느 거래에서 비중이 변했는지 확인할 수 있습니다.',
    screens: ['0101', '0197'],
  },
  {
    title: 'KRX·NXT의 차트 기준',
    summary: '통합키움차트에서 현재 선택된 거래소를 확인합니다. 차트와 통합 호가창을 같이 읽을 때에는 종목, 거래소, 조회 시각을 맞춥니다.',
    screens: ['6600', '8284'],
  },
  {
    title: '거래 기록과 장중 흐름 복기',
    summary: '자동일지차트에서 거래 시각과 당시 메모를 확인하고, 복기차트에서 해당 시간대의 장중 가격 흐름을 재생합니다. 조회 가능 시간과 저장 여부는 공식 안내에서 확인합니다.',
    screens: ['0606', '0605'],
  },
  {
    title: '홍콩주식의 지연시세',
    summary: '현재가 화면에서 실시간·지연시세 여부와 거래통화를 확인합니다. 15분 지연 종합차트를 같이 열었다면 차트의 표시 시각을 기준으로 시세 흐름을 비교합니다.',
    screens: ['3010', '3098'],
  },
];
---
<HeroLayout title="화면 활용 인사이트">
  <div class="hero-grid">
    {insights.map(({ title, summary, screens }) => <section class="hero-card">
      <h2>{title}</h2>
      <p>{summary}</p>
      <ul class="hero-chips">
        {screens.map((number) => <li><a href={sitePath('hero-lab/screens/' + number)}>{number} {screenByNumber(number).title}</a></li>)}
      </ul>
    </section>)}
  </div>
  <section class="hero-section">
    <h2>공식 안내</h2>
    <ul>{heroGuides.map(({ title, url }) => <li><a href={url}>{title}</a></li>)}</ul>
  </section>
</HeroLayout>
