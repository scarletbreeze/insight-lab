---
import BrokerLayout from '../../../components/broker/BrokerLayout.astro';
import BrokerTrend from '../../../components/broker/BrokerTrend';
import BrokerTurningPoints from '../../../components/broker/BrokerTurningPoints';
import MoneyMap from '../../../components/broker/MoneyMap';
import DisclosedSegments from '../../../components/broker/DisclosedSegments.astro';
import { brokers, brokerMetrics, fields, formatBrokerMetric, formatIndustryRank, industryPeriods, industryRanks, interimProfit, priorInterimProfit } from '../../../utils/brokers';
import { sitePath } from '../../../utils/paths';

export function getStaticPaths() {
  return industryRanks.map((company) => ({
    params: { broker: company.id },
    props: { company, broker: brokers.find(({ id }) => id === company.id) },
  }));
}
const { company, broker } = Astro.props;
const rows = brokerMetrics.filter(({ id }) => id === company.id).sort((a, b) => b.year - a.year);
const latest = rows[0];
const snapshots = industryPeriods.flatMap((period) => {
  const entry = period.companies.find(({ id }) => id === company.id);
  return entry ? [{ ...period, entry }] : [];
});
const currentProfit = interimProfit.companies.find(({ id }) => id === company.id);
const previousProfit = priorInterimProfit.companies.find(({ id }) => id === company.id);
const profitFields = [
  { key: 'netIncome', label: '당기순이익' },
  { key: 'operatingIncome', label: '영업이익' },
] as const;
const changeFormat = new Intl.NumberFormat('ko-KR', { style: 'percent', signDisplay: 'exceptZero', maximumFractionDigits: 1 });
---
<BrokerLayout title={company.name}>
  <p slot="intro">{broker ? <>회사 소개 초안 · {broker.character} <a href={broker.characterSourceUrl ?? broker.sourceUrl}>회사 소개 근거</a></> : '별도 재무현황과 연결 결산 자료'}</p>
  {currentProfit && <section class="lab-block">
    <h2>{interimProfit.label} 연결 실적</h2>
    <dl class="lab-grid">
      {profitFields.map(({ key, label }) => {
        const previous = previousProfit?.[key];
        const current = currentProfit[key];
        return <div class="lab-card">
          <dt>{label}</dt>
          <dd><strong>{formatBrokerMetric(current, false)}</strong></dd>
          {previous != null && <dd>
            2025년 1~9월 {formatBrokerMetric(previous, false)}
            {previous > 0 && <> · 전년 동기 대비 {changeFormat.format(current / previous - 1)}</>}
          </dd>}
        </div>;
      })}
    </dl>
    <ul class="lab-chips" aria-label="연결 손익 출처">
      <li><a href={currentProfit.sourceUrl}>2026년 실적 공시</a></li>
      {previousProfit && <li><a href={previousProfit.sourceUrl}>2025년 비교 수치 공시</a></li>}
    </ul>
  </section>}
  <section class="lab-block">
    <h2>업계 비교 기준일별 별도 재무현황</h2>
    <div class="lab-grid">{snapshots.map(({ label, date, entry, scope, confirmedTopCount, rankSourceUrl, rankSourceName }) => (
      <article class="lab-card">
        <h3>{label} · 자본총계 {formatIndustryRank(entry.rank, confirmedTopCount, date)}</h3>
        <p><time datetime={date}>{date}</time> · 별도 재무제표 · {scope}</p>
        <dl class="lab-facts">
          <div><dt>자본총계</dt><dd>{formatBrokerMetric(entry.equity, false)}</dd></div>
          <div><dt>자산총계</dt><dd>{formatBrokerMetric(entry.assets, false)}</dd></div>
          <div><dt>부채총계</dt><dd>{formatBrokerMetric(entry.liabilities, false)}</dd></div>
          <div><dt>자본금</dt><dd>{formatBrokerMetric(entry.capital, false)}</dd></div>
        </dl>
        <a href={entry.sourceUrl}>{entry.sourceName}</a>
        {rankSourceUrl && <a href={rankSourceUrl}>{rankSourceName}</a>}
      </article>
    ))}</div>
  </section>
  {broker ? <>
  <section class="lab-block">
    <h2>연결 결산 추이</h2>
    {latest && <dl class="lab-grid" aria-label={latest.year + '년 핵심 연결 지표'}>
      {fields.filter(({ key }) => ['equity', 'netIncome', 'operatingIncome', 'assets', 'roe'].includes(key)).map(({ key, title, percent }) => (
        <div class="lab-card"><dt>{title} · {latest.year}</dt><dd><strong>{formatBrokerMetric(latest[key], percent)}</strong></dd></div>
      ))}
    </dl>}
    <BrokerTrend client:load companies={[company]} />
    <div class="lab-table-wrap"><table class="lab-table">
      <thead><tr><th scope="col">연도</th>{fields.map(({ title }) => <th scope="col">{title}</th>)}</tr></thead>
      <tbody>{rows.map((row) => <tr><th scope="row"><a href={row.sourceUrl}>{row.year}년 공시</a>
        {row.year === 2021 && row.previousSourceUrl && <div><a href={row.previousSourceUrl}>2020년 비교 기준</a></div>}
      </th>{fields.map(({ key, percent }) => <td>
        {formatBrokerMetric(row[key], percent)}
        {key === 'operatingIncome' && row.operatingIncomeSourceUrl && <a href={row.operatingIncomeSourceUrl} aria-label={row.year + '년 영업이익 공시'}> 공시</a>}
      </td>)}</tr>)}</tbody>
    </table></div>
  </section>
  <section class="lab-block" id="money-map">
    <h2>Money Map</h2><MoneyMap {broker} />
    <p><a href={sitePath('broker-atlas/compare') + '?left=' + broker.id + '#compare-money-map'}>다른 회사와 수익 경로 비교</a> · <a href={'#disclosed-segments-' + broker.id}>공시 부문별 금액</a></p>
  </section>
  <DisclosedSegments brokerId={company.id} />
  <section class="lab-block" id="turning-points">
    <h2>주요 전환점</h2>
    <a href={sitePath('broker-atlas/compare') + '?left=' + company.id + '#compare-turning-points'}>다른 증권사와 전환점 비교</a>
    <BrokerTurningPoints brokerId={company.id} detail />
  </section>
  </> : <section class="lab-block"><h2>연결 결산 추이와 사업 구조</h2><p class="empty-state">자료 확인 중</p></section>}
</BrokerLayout>
