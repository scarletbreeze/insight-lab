---
import BrokerYearOverview from '../../components/broker/BrokerYearOverview';
import BrokerProfitRanking from '../../components/broker/BrokerProfitRanking';
import BrokerLayout from '../../components/broker/BrokerLayout.astro';
import IndustrySnapshot from '../../components/broker/IndustrySnapshot';
import { sitePath } from '../../utils/paths';
---
<BrokerLayout title="Broker Atlas">
  <p slot="intro">공시로 증권사의 규모, 수익성, 사업 구조를 살펴봅니다.</p>
  <nav class="lab-chips" aria-label="실적 바로가기">
    <a href="#broker-profit-title">이익 순위</a>
    <a href="#annual-results">연도별 결산</a>
  </nav>
  <BrokerProfitRanking client:load brokerBase={sitePath('broker-atlas/brokers')} />
  <section class="lab-block" id="annual-results">
    <h2>연도별 연결 결산</h2>
    <BrokerYearOverview client:load brokerBase={sitePath('broker-atlas/brokers')} />
    <p><a href={sitePath('broker-atlas/rankings')}>자본총계·이익·ROE·성장률 순위</a></p>
  </section>
  <section class="lab-block">
    <h2>기준일별 별도 자본총계</h2>
    <IndustrySnapshot client:load view="cards" brokerBase={sitePath('broker-atlas/brokers')} />
  </section>
  <section class="lab-block">
    <h2>수익이 만들어지는 경로</h2>
    <p>위탁매매, 자산관리, 기업금융의 고객·사업·수익원을 확인합니다.</p>
    <a href={sitePath('broker-atlas/money-map')}>Money Map 보기</a>
  </section>
  <section class="lab-block"><h2>증권사 비교</h2><a href={sitePath('broker-atlas/compare')}>두 회사의 결산 지표 비교</a></section>
</BrokerLayout>
