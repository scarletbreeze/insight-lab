---
import CeoLayout from '../../../components/ceo/CeoLayout.astro';
import StoConsortiumTable from '../../../components/ceo/StoConsortiumTable.astro';
import SignalList from '../../../components/ceo/SignalList.astro';
import { briefSignals, briefs } from '../../../utils/ceo';
import { sitePath } from '../../../utils/paths';

export function getStaticPaths() {
  return briefs.map((brief) => ({ params: { id: brief.id }, props: { brief } }));
}
const { brief } = Astro.props;
const related = briefSignals(brief);
const others = briefs.filter(({ id }) => id !== brief.id);
const hostname = (url: string) => new URL(url).hostname.replace(/^www\./, '');
---
<CeoLayout title={brief.title}>
  <p slot="intro">{brief.oneLine} · <a href={sitePath('ceo-lens/briefs')}>브리프 목록</a></p>
  <section class="lab-block" id="what">
    <h2>무엇인가</h2>
    <dl class="lab-card">
      <dt>확인한 사실</dt><dd>{brief.whatItIs}</dd>
      <dt>기록 갱신일</dt><dd><time datetime={brief.lastUpdated}>{brief.lastUpdated}</time></dd>
    </dl>
  </section>
  <section class="lab-block" id="numbers">
    <h2>핵심 수치</h2>
    <p>값마다 기준일과 원문을 붙였습니다. 기준일이 다른 수치는 같은 시점의 비교로 읽지 않습니다.</p>
    <ul class="lab-grid" role="list">
      {brief.keyNumbers.map(({ label, value, unit, asOf, sourceUrl }) => <li class="lab-card">
        <span>{label}</span>
        <strong>{value}{unit && <> <small>{unit}</small></>}</strong>
        <span><time datetime={asOf}>{asOf}</time> 기준 · <a href={sourceUrl}>{hostname(sourceUrl)}</a></span>
      </li>)}
    </ul>
  </section>
  <section class="lab-block" id="how">
    <h2>어떻게 작동하나</h2>
    <ol class="lab-list">
      {brief.howItWorks.map(({ text, sourceName, sourceUrl }) => <li>
        <p>{text}</p>
        <small>출처 · <a href={sourceUrl}>{sourceName}</a></small>
      </li>)}
    </ol>
  </section>
  <section class="lab-block" id="why">
    <h2>왜 살펴볼까</h2>
    <dl class="lab-card">
      <dt>해석</dt><dd>{brief.whyItMatters}</dd>
      <dt>구분</dt><dd>위 문단은 공개 자료를 읽고 정리한 관찰이며, 경영 판단이나 권고가 아닙니다. 사실 확인은 위 '어떻게 작동하나'의 출처를 따릅니다.</dd>
    </dl>
  </section>
  {brief.id === 'token-securities' && <StoConsortiumTable />}
  <section class="lab-block" id="readings">
    <h2>읽어볼 자료</h2>
    <ul class="lab-list">
      {brief.readings.map(({ title, publisher, url, date, note }) => <li>
        <time datetime={date}>{date}</time><a href={url} rel="external">{title}</a>
        <br /><small>{publisher} · {note} · {hostname(url)}</small>
      </li>)}
    </ul>
  </section>
  {related.length > 0 && <section class="lab-block" id="signals">
    <h2>관련 시그널</h2>
    <SignalList items={related} />
  </section>}
  {others.length > 0 && <section class="lab-block">
    <h2>다른 브리프</h2>
    <div class="lab-grid">{others.map(({ id, title, oneLine }) => <a class="lab-card" href={sitePath('ceo-lens/briefs/' + id)}><strong>{title}</strong><span>{oneLine}</span></a>)}</div>
  </section>}
</CeoLayout>
