---
import CeoLayout from '../../components/ceo/CeoLayout.astro';
import SignalList from '../../components/ceo/SignalList.astro';
import HorizontalBars from '../../components/charts/HorizontalBars.astro';
import StackedCount from '../../components/charts/StackedCount.astro';
import { briefs, ceoSections, signals, weeklyEditions } from '../../utils/ceo';
import { sitePath } from '../../utils/paths';

const edition = weeklyEditions[0];
const featured = edition?.question ?? signals[0];
const related = edition?.related ?? [];
const allSignals = sitePath('ceo-lens/signals');
const sourceCount = new Set(signals.map(({ sourceUrl }) => sourceUrl)).size;
const topicCount = new Set(signals.map(({ category }) => category)).size;
const guides = ceoSections.filter(([, slug]) => ['regulation', 'competitors', 'ai-digital', 'digital-assets', 'global', 'capital-roadmap'].includes(slug));
// Each signal has exactly one category, so the segmented bar is a true split of the collection.
const categoryCounts = [...signals.reduce((map, { category }) => map.set(category, (map.get(category) ?? 0) + 1), new Map<string, number>())]
  .sort((a, b) => b[1] - a[1])
  .map(([label, value]) => ({ id: label, label, value, href: allSignals + '?topic=' + encodeURIComponent(label) }));
// A signal may belong to several theme pages, so these counts are read per page, not as shares.
const areaCounts = guides.map(([label, slug]) => ({
  id: slug, label, href: sitePath('ceo-lens/' + slug), value: signals.filter(({ areas }) => areas.includes(slug)).length,
})).sort((a, b) => b.value - a.value);
---
<CeoLayout title="CEO Lens">
  <p slot="intro">내가 증권사 CEO라면, 지금 무엇을 봐야 할까?</p>
  <dl class="lab-facts" aria-label="CEO Lens 수록 현황">
    <div><dt>시그널</dt><dd>{signals.length}건</dd></div>
    <div><dt>주제</dt><dd>{topicCount}개</dd></div>
    <div><dt>연결 출처</dt><dd>{sourceCount}개</dd></div>
  </dl>
  <section class="lab-block">
    <h2>주간 CEO 질문</h2>
    <p>{featured.question}</p>
    <a href={allSignals + '#' + featured.id}>질문의 근거가 된 발표 보기</a>
    {related.length > 0 && <ul class="lab-list">
      {related.map(({ id, title }) => <li><a href={allSignals + '#' + id}>{title}</a></li>)}
    </ul>}
  </section>
  <section class="lab-block">
    <h2>{edition?.title ?? '최근 수록 시그널'}</h2>
    <p>{edition && <><time datetime={edition.start}>{edition.start}</time>~<time datetime={edition.through}>{edition.through}</time> 공개 자료 · </>}시그널 {(edition?.items ?? signals.slice(0, 5)).length}건. 제목을 누르면 주제 페이지의 전체 내용으로 이동합니다.</p>
    <SignalList items={edition?.items ?? signals.slice(0, 5)} variant="index" />
    <p><a href={sitePath('ceo-lens/archive') + '#weekly'}>주간 발행 기록 보기</a></p>
  </section>
  <section class="lab-block" id="briefs">
    <h2>브리프 — 제도 설명과 읽을 자료</h2>
    <p>시그널에 자주 나오는 제도를 짧게 설명하고, 읽어볼 만한 공개 자료로 연결합니다.</p>
    <ul class="lab-list">{briefs.map((brief) => <li><a href={sitePath('ceo-lens/briefs/' + brief.id)}>{brief.title}</a> · {brief.oneLine}</li>)}</ul>
    <p><a href={sitePath('ceo-lens/briefs')}>브리프 전체 보기</a></p>
  </section>
  <section class="lab-block">
    <details class="lab-fold">
    <summary><h2>수록 구성</h2> <span class="lab-fold__count">분류 {topicCount}개 · 주제 페이지 {guides.length}개</span></summary>
    <StackedCount parts={categoryCounts} caption={`<strong>시그널 ${signals.length}건의 분류별 구성</strong> — 시그널마다 분류가 하나이며, 분류명을 누르면 해당 분류만 걸러 본 공개 시그널 목록으로 이동합니다.`} />
    <h3>주제별 탐색</h3>
    <HorizontalBars items={areaCounts} format={(value) => value + '건'} labelWidth="9.5rem" valueWidth="3.5rem"
      caption="주제 페이지별 수록 건수입니다. 한 시그널이 여러 주제에 속할 수 있어 합계는 전체 건수보다 큽니다. 주제명을 누르면 해당 페이지로 이동합니다." />
    <p><a href={sitePath('ceo-lens/archive')}>아카이브 · 주간 발행 기록</a></p>
    </details>
  </section>
  <section class="lab-block">
    <h2>출처와 수록 기준</h2>
    <p>수록 자료 중 최근 발표일 <time datetime={signals[0].date}>{signals[0].date}</time></p>
    <a href={sitePath('ceo-lens/methodology')}>출처 및 시그널 수록 기준</a>
  </section>
</CeoLayout>
