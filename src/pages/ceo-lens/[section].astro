---
import CeoLayout from '../../components/ceo/CeoLayout.astro';
import CapitalRoadmap from '../../components/ceo/CapitalRoadmap.astro';
import DigitalAssetGuide from '../../components/ceo/DigitalAssetGuide.astro';
import SignalList from '../../components/ceo/SignalList.astro';
import Timeline from '../../components/charts/Timeline.astro';
import { ceoSections, latestUpdate, signals, weeklyEditions } from '../../utils/ceo';
import { sitePath } from '../../utils/paths';

export function getStaticPaths() {
  return ceoSections.map(([title, section]) => ({ params: { section }, props: { title, section } }));
}
const { title, section } = Astro.props;
const showAll = section === 'signals' || section === 'archive';
const items = showAll ? signals : signals.filter(({ areas }) => areas.includes(section));
const years = [...new Set(items.map(({ date }) => date.slice(0, 4)))].sort().reverse();
const businessAreas = [...new Set(items.flatMap((item) => item.businessAreas))].sort();
const categories = [...new Set(items.map(({ category }) => category))];
const applications = [...new Set(items.flatMap(({ applications }) => applications ?? []))].sort((a, b) => a.localeCompare(b, 'ko'));
const timelineEvents = items.map(({ date, title, id, region }) => ({ date, label: title, href: '#' + id, kind: region === 'KR' ? 'kr' : 'global' }));
const timelineKinds = [{ id: 'kr', label: '국내' }, { id: 'global', label: '해외' }];
// The global page keys its timeline by topic instead of region: every case is 해외.
const caseTimelineEvents = items.map(({ date, title, id, category }) => ({ date, label: title, href: '#' + id, kind: category }));
const caseTimelineKinds = categories.map((category) => ({ id: category, label: category }));
// Archive rows, the all-signals page and any topic page with more than twelve signals are grouped per year;
// the newest group opens, older ones stay closed. Links into a closed group open it (HashReveal in SignalList).
const grouped = section === 'archive' || section === 'signals' || items.length > 12;
const archiveYears = years.map((year) => ({ year, items: items.filter(({ date }) => date.startsWith(year)) }));
const lastUpdated = latestUpdate(items.length ? items : signals);
---
<CeoLayout {title}>
  {section === 'archive' && <section class="lab-block" id="weekly">
    <h2>주간 발행 기록</h2>
    <ul class="lab-list">{weeklyEditions.map(({ start, through, title, items, question, related }) => <li class="lab-card">
      <h3>{title}</h3>
      <p><time datetime={start}>{start}</time>~<time datetime={through}>{through}</time> 공개 자료</p>
      <p>{question.question}</p>
      <details><summary>질문과 함께 볼 자료</summary>
        <ul>{related.map(({ title, sourceUrl }) => <li><a href={sourceUrl}>{title}</a></li>)}</ul>
      </details>
      <ul class="lab-list">{items.map(({ id, title }) => <li><a href={sitePath('ceo-lens/signals') + '#' + id}>{title}</a></li>)}</ul>
    </li>)}</ul>
  </section>}
  {section === 'capital-roadmap' && <CapitalRoadmap />}
  {section === 'digital-assets' && <DigitalAssetGuide />}
  {section === 'methodology' ? <section class="lab-block">
    <h2>시그널 정리 기준</h2>
    <p>규제 당국 발표와 공시에서 확인할 수 있는 사실을 추립니다. 발표 시점과 제도 시행 예정일을 구분하고, 사업에 미칠 영향은 질문의 형태로 설명합니다.</p>
    <p>주간 발행에는 자료를 확인한 시작일과 마지막 날을 표시합니다. 발행 범위에 들어오는 시그널과 대표 질문은 아카이브에 남깁니다.</p>
    <p>각 시그널에는 발표·관할 기관, 출처가 밝힌 시행일, 출처를 마지막으로 다시 열어 확인한 날짜(최근 확인)를 기록합니다. 시그널 최근 확인일은 출처를 재확인한 날짜이며 발표일이나 글을 작성한 날짜가 아니고, 페이지 머리의 Last Updated(사이트 갱신일)와도 다른 값입니다. 현재 시그널 최근 확인일 <time datetime={lastUpdated}>{lastUpdated}</time></p>
  </section> : <section class="lab-block">
    {section === 'digital-assets' && <h2>정책과 인프라 타임라인</h2>}
    {section === 'regulation' && <>
      <h2>규제 시그널 타임라인</h2>
      <Timeline events={timelineEvents} kinds={timelineKinds} title={`규제 시그널 ${items.length}건의 발표 시점`} fallback="narrow"
        caption={`<strong>규제 시그널 ${items.length}건의 발표 시점</strong> — 넓은 화면에서는 연도 축 위의 제목을, 좁은 화면에서는 연도별 목록의 제목을 누르면 아래 목록의 해당 줄이 펼쳐집니다. 아래 필터는 목록에만 적용됩니다.`} />
    </>}
    {section === 'global' && <>
      <h2>해외 사례 타임라인</h2>
      <Timeline events={caseTimelineEvents} kinds={caseTimelineKinds} title={`해외 사례 ${items.length}건의 발표 시점`} fallback="narrow"
        caption={`<strong>해외 사례 ${items.length}건의 발표 시점</strong> — 주제별 표시. 제목을 누르면 아래 목록의 해당 줄이 펼쳐집니다. 각 줄은 날짜·주제·기관·제목이고, 질문·출처·사례 내용·살펴볼 이유는 줄을 펼치면 보입니다.`} />
    </>}
    {section === 'archive' && <h2>시그널 아카이브</h2>}
    {!['archive', 'regulation', 'global', 'digital-assets'].includes(section) && <h2>{title} {items.length}건{grouped ? ' — 연도별' : ''}</h2>}
    <ceo-filters>
      <div class="lab-controls">
        <label>발표 연도 <select data-filter="year"><option value="">전체</option>{years.map((year) => <option>{year}</option>)}</select></label>
        {categories.length > 1 && <label>주제 <select data-filter="topic"><option value="">전체</option>{categories.map((category) => <option>{category}</option>)}</select></label>}
        {section === 'ai-digital' && <label>적용 분야 <select data-filter="application"><option value="">전체</option>{applications.map((application) => <option>{application}</option>)}</select></label>}
        {section === 'competitors' && <label>지역 <select data-filter="region"><option value="">전체</option><option value="KR">국내</option><option value="GLOBAL">해외</option></select></label>}
        {section === 'regulation' && <label>업무 영역 <select data-filter="area"><option value="">전체</option>{businessAreas.map((area) => <option>{area}</option>)}</select></label>}
        <button type="button" data-reset hidden>필터 초기화</button>
      </div>
      <p role="status">{items.length}건</p>
      {grouped ? archiveYears.map(({ year, items }, index) => <details class="lab-fold" data-year-group={year} open={index === 0}>
        <summary><h3>{year}년</h3> <span class="lab-fold__count">{items.length}건</span></summary>
        <SignalList {items} cases={section === 'global'} variant={section === 'archive' ? 'index' : 'fold'} heading="h4" />
      </details>) : <SignalList {items} cases={section === 'global'} variant="fold" />}
    </ceo-filters>
    <p class="chart-note">시그널 최근 확인일 <time datetime={lastUpdated}>{lastUpdated}</time> — 이 페이지의 시그널 중 가장 최근에 출처를 다시 열어 확인한 날짜입니다. 발표일이나 작성일이 아닙니다.</p>
  </section>}
</CeoLayout>
<script>
  class CeoFilters extends HTMLElement {
    connectedCallback() {
      const controller = new AbortController();
      this.cleanup = () => controller.abort();
      const filters = Array.from(this.querySelectorAll<HTMLSelectElement>('select[data-filter]'));
      const status = this.querySelector('[role="status"]');
      const items = Array.from(this.querySelectorAll<HTMLElement>('[data-year]'));
      const groups = Array.from(this.querySelectorAll<HTMLDetailsElement>('details[data-year-group]'));
      const reset = this.querySelector<HTMLButtonElement>('[data-reset]');
      if (!status) return;
      if (reset) reset.hidden = false;
      const render = () => {
        const visible = items.filter((item) => {
          const match = filters.every(({ dataset, value }) =>
            !value || item.dataset[dataset.filter ?? '']?.split('|').includes(value));
          item.hidden = !match;
          return match;
        });
        status.textContent = visible.length ? `${visible.length}건` : '선택한 조건에 맞는 시그널이 없습니다.';
        // Archive: a year group hides when none of its rows match; an active filter opens the groups that still match.
        const filtering = filters.some(({ value }) => value);
        for (const group of groups) {
          const shown = Array.from(group.querySelectorAll<HTMLElement>('[data-year]')).filter((item) => !item.hidden).length;
          group.hidden = shown === 0;
          if (filtering && shown) group.open = true;
          const count = group.querySelector('.lab-fold__count');
          if (count) count.textContent = `${shown}건`;
        }
      };
      const loadUrl = () => {
        const params = new URLSearchParams(location.search);
        for (const filter of filters) {
          const value = params.get(filter.dataset.filter!) ?? '';
          filter.value = Array.from(filter.options).some((option) => option.value === value) ? value : '';
        }
        render();
      };
      const saveUrl = () => {
        const url = new URL(location.href);
        for (const filter of filters) {
          const key = filter.dataset.filter!;
          if (filter.value) url.searchParams.set(key, filter.value);
          else url.searchParams.delete(key);
        }
        if (url.href !== location.href) {
          url.hash = '';
          history.pushState(null, '', url);
        }
        render();
      };
      const options = { signal: controller.signal };
      this.addEventListener('change', saveUrl, options);
      reset?.addEventListener('click', () => {
        for (const filter of filters) filter.value = '';
        saveUrl();
      }, options);
      window.addEventListener('popstate', loadUrl, options);
      loadUrl();
    }
    private cleanup?: () => void;
    disconnectedCallback() { this.cleanup?.(); }
  }
  customElements.define('ceo-filters', CeoFilters);
</script>
