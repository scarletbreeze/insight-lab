---
import CeoLayout from '../../components/ceo/CeoLayout.astro';
import SignalList from '../../components/ceo/SignalList.astro';
import { ceoSections, signals } from '../../utils/ceo';

export function getStaticPaths() {
  return ceoSections.map(([title, section]) => ({ params: { section }, props: { title, section } }));
}
const { title, section } = Astro.props;
const showAll = section === 'signals' || section === 'archive';
const items = showAll ? signals : signals.filter(({ areas }) => areas.includes(section));
const years = [...new Set(items.map(({ date }) => date.slice(0, 4)))];
const categories = [...new Set(items.map(({ category }) => category))];
---
<CeoLayout {title}>
  {section === 'methodology' ? <section class="lab-block">
    <h2>시그널 정리 기준</h2>
    <p>규제 당국 발표와 공시에서 확인할 수 있는 사실을 추립니다. 발표 시점과 제도 시행 예정일을 구분하고, 사업에 미칠 영향은 질문의 형태로 설명합니다.</p>
  </section> : <section class="lab-block">
    {section === 'capital-roadmap' && <p>발표 당시 확인된 지정·인가를 기준으로 수록했습니다.</p>}
    <ceo-filters>
      <div class="lab-controls">
        <label>발표 연도 <select data-filter="year"><option value="">전체</option>{years.map((year) => <option>{year}</option>)}</select></label>
        <label>주제 <select data-filter="topic"><option value="">전체</option>{categories.map((category) => <option>{category}</option>)}</select></label>
      </div>
      <p role="status">{items.length}건</p>
      <SignalList {items} />
    </ceo-filters>
  </section>}
</CeoLayout>
<script>
  class CeoFilters extends HTMLElement {
    connectedCallback() {
      const year = this.querySelector<HTMLSelectElement>('[data-filter="year"]');
      const topic = this.querySelector<HTMLSelectElement>('[data-filter="topic"]');
      const status = this.querySelector('[role="status"]');
      const items = Array.from(this.querySelectorAll<HTMLElement>('[data-year]'));
      if (!year || !topic || !status) return;
      this.addEventListener('change', () => {
        const visible = items.filter((item) => {
          const match = (!year.value || item.dataset.year === year.value) && (!topic.value || item.dataset.topic === topic.value);
          item.hidden = !match;
          return match;
        });
        status.textContent = visible.length ? `${visible.length}건` : '선택한 조건에 맞는 시그널이 없습니다.';
      });
    }
  }
  customElements.define('ceo-filters', CeoFilters);
</script>
